{
  "permissions": {
    "allow": [
      "mcp__alpaca-paper"
    ],
    "ask": [
      "mcp__alpaca-live__place_stock_order",
      "mcp__alpaca-live__close_position"
    ],
    "deny": [
      "mcp__alpaca-paper__place_option_order",
      "mcp__alpaca-paper__place_crypto_order",
      "mcp__alpaca-paper__exercise_options_position",
      "mcp__alpaca-paper__do_not_exercise_options_position",
      "mcp__alpaca-paper__replace_order_by_id",
      "mcp__alpaca-paper__close_all_positions",
      "mcp__alpaca-paper__update_account_config",
      "mcp__alpaca-live__place_option_order",
      "mcp__alpaca-live__place_crypto_order",
      "mcp__alpaca-live__exercise_options_position",
      "mcp__alpaca-live__do_not_exercise_options_position",
      "mcp__alpaca-live__replace_order_by_id",
      "mcp__alpaca-live__close_all_positions",
      "mcp__alpaca-live__update_account_config"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__alpaca.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/trading/guard.py\""
          }
        ]
      }
    ]
  }
}
